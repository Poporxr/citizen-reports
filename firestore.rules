rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Incidents feed
    match /incidents/{incidentId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      // Likes subcollection (live upvotes)
      match /likes/{userId} {
        allow read: if signedIn();
        allow create, update, delete: if ownsUserDoc(userId);
      }

      // Comments subcollection (community updates)
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if signedIn()
          && resource.data.userId == request.auth.uid;
      }
    }

    // Global in-app notification documents. Clients may create notifications
    // for their own incident activity, but read-state remains per user below.
    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.type == "new_incident"
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.incidentId is string;
      allow update, delete: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if ownsUserDoc(userId);
      allow delete: if false;

      // Per-user notification read state. Users can only mark their own
      // notifications as read; global notification docs are never mutated.
      match /notificationReads/{notificationId} {
        allow read: if ownsUserDoc(userId);
        allow create, update: if ownsUserDoc(userId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.notificationId == notificationId;
        allow delete: if false;
      }
    }
  }
}
