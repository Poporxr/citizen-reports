rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Incidents feed:
    // Anyone can read incidents (live community feed)
    // Authenticated users can submit new incidents
    // Only the creator can edit/delete their own incident
    match /incidents/{incidentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Users collection:
    // Profiles are readable so author names and reporter badges show in the feed
    // Users can create and edit their own profile document
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
