rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Incidents feed
    match /incidents/{incidentId} {
      allow read, write: if true;

      // Likes subcollection (live upvotes)
      match /likes/{userId} {
        allow read, write: if true;
      }

      // Comments subcollection (community updates)
      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Recursive rule to ensure subcollections are always accessible
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
