rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Incident pictures:
    // Anyone can view incident pictures
    // Only authenticated users can upload pictures to their own path: incidents/{userId}/{fileName}
    match /incidents/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
